{
  "firestore": {
    "rules": "firebase/firestore.rules",
    "indexes": "firebase/firestore.indexes.json"
  },
  "emulators": {
    "auth": {
      "port": 9099
    },
    "firestore": {
      "port": 8080
    },
    "ui": {
      "enabled": true
    },
    "functions": {
      "port": 5001
    }
  },
  "storage": {
    "rules": "firebase/storage.rules"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "runtime": "nodejs22",
      "predeploy": [
        "pnpm --dir functions install --ignore-workspace",
        "pnpm --dir functions build"
      ],
      "ignore": [
        "node_modules",
        ".git",
        "src",
        "build.mjs",
        "tsconfig.json"
      ]
    }
  ]
}
