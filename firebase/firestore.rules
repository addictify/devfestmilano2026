rules_version = '2';

// Phase 1 posture: public content is world-readable. All content writes happen
// via the Admin SDK (which bypasses rules) or from admins (custom claim).
// The Phase 2 `users/**` rules are included now so favorites work when shipped.
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    function isValidSubscriber() {
      return request.resource.data.keys().hasOnly(['email', 'createdAt', 'locale', 'source'])
        && request.resource.data.email is string
        && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
        && request.resource.data.email.size() < 254;
    }

    match /speakers/{id} { allow read: if true; allow write: if isAdmin(); }
    match /sessions/{id} { allow read: if true; allow write: if isAdmin(); }
    match /tracks/{id}   { allow read: if true; allow write: if isAdmin(); }
    match /sponsors/{id} { allow read: if true; allow write: if isAdmin(); }
    match /team/{id}     { allow read: if true; allow write: if isAdmin(); }
    // config/site carries the public feature flags and must stay readable.
    // config/publish is internal deploy bookkeeping — excluded explicitly,
    // because rules are OR'd: a narrower rule below could not take a read
    // permission away that this one grants.
    match /config/{id} {
      allow read: if id != "publish";
      allow write: if isAdmin();
    }

    match /news/{id} {
      allow read: if resource.data.published == true || isAdmin();
      allow write: if isAdmin();
    }

    // Phase 2 — personal "My Schedule".
    match /users/{uid} {
      allow read, write: if isOwner(uid);
      match /{sub=**} {
        allow read, write: if isOwner(uid);
      }
    }

    match /subscribers/{id} {
      allow create: if isValidSubscriber();
      allow read, update, delete: if isAdmin();
    }

    match /checkpoints/{id} { allow read, write: if isAdmin(); }
    match /badges/{id}      { allow read: if true; allow write: if isAdmin(); }
    match /leaderboard/{uid} { allow read: if true; allow write: if false; }
    match /gameProfiles/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
      match /scans/{cid} { allow read: if isOwner(uid); allow write: if false; }
    }
    // The published rating: a count, and an average only once enough people
    // have voted. World-readable so a session card can show it. Rules grant a
    // document, never a field, so the running sum must not live here — with a
    // count of 1 the sum is that person's rating.
    match /feedback/{sid} {
      allow read: if true;
      allow write: if false;
    }
    // The running totals behind it, sum included. Server-side only; rules do
    // not cascade, so the public rule above does not reach this.
    match /feedback/{sid}/totals/{id} {
      allow read, write: if false;
    }
    match /feedback/{sid}/responses/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      // Written only by /api/feedback, which updates the response and the
      // public counters in one transaction. Letting a client write its own
      // response directly (as it could before) would leave the counters behind
      // the responses, and a determined one could rate a talk, revise it a
      // hundred times and never move the average it advertises.
      allow write: if false;
      allow delete: if false;
    }

    // Push subscriptions carry an endpoint that is a capability: anyone who
    // can read one can send that device a notification. Written only by
    // /api/push/subscribe, read only by the Admin SDK.
    match /pushSubscriptions/{id} {
      allow read, write: if false;
    }
    // What was announced to the room, and by whom.
    match /announcements/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Deny everything else.
    match /{document=**} { allow read, write: if false; }
  }
}
