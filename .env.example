# ----------------------------------------------------------------------------
# DevFest Milano 2026 — environment variables
# Copy to `.env.local` and fill in. The site runs WITHOUT any of these (it falls
# back to bundled seed content); fill them in to wire real data and deploy.
# ----------------------------------------------------------------------------

# Where the API lives. Leave EMPTY when running the full Next app (dev or a
# server deploy): calls stay same-origin. Set it to the Cloud Function URL for
# the static export, whose frontend is served from GitHub Pages.
# e.g. https://europe-west1-devfestmilano26.cloudfunctions.net/api
NEXT_PUBLIC_API_BASE_URL=

# Public site URL (used for canonical/OG/sitemap)
NEXT_PUBLIC_SITE_URL="https://devfest.gdgmilano.it"

# External links (optional overrides for src/lib/site.ts defaults)
NEXT_PUBLIC_TICKETS_URL="https://gdg.community.dev/gdg-milano/"
NEXT_PUBLIC_CFP_URL="https://sessionize.com/devfest-milano-2026"

# --- Firebase Web SDK (public — safe to expose; client Auth + Firestore) ---
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""

# --- Firebase Admin SDK (server only — service account; NEVER commit) ---
FIREBASE_ADMIN_PROJECT_ID=""
FIREBASE_ADMIN_CLIENT_EMAIL=""
# Paste the private key with literal \n for newlines, wrapped in quotes.
FIREBASE_ADMIN_PRIVATE_KEY=""

# --- Sessionize (Call for Papers / talks / speakers) ---
# The short event id from the Sessionize URL.
SESSIONIZE_EVENT_ID=""

# --- Secrets for the API routes ---
# Guards POST /api/revalidate and manual ?secret= access to /api/sync.
REVALIDATE_SECRET=""
# Set on Vercel; the Cron scheduler sends it as `Authorization: Bearer <CRON_SECRET>`.
CRON_SECRET=""
